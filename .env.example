DATABASE_URL=postgresql+psycopg://civicguide:civicguide@localhost:5432/civicguide
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me-admin-token
CORS_ORIGINS=http://localhost:3000
WEIGHT_ELIGIBILITY=0.35
WEIGHT_NEED=0.25
WEIGHT_LOCATION=0.15
WEIGHT_PROFILE=0.10
WEIGHT_EDUCATION_OCCUPATION=0.10
WEIGHT_USEFULNESS=0.05
EMBEDDING_MODEL=all-MiniLM-L6-v2
USE_TRANSFORMERS=false
RAW_SNAPSHOT_DIR=data/raw_snapshots
RATE_LIMIT_PER_MINUTE=120
# Required for the extractor (Phase 3, see docs/TRUST_PIPELINE.md) - without at
# least one of these, fetching/hash-diffing still works but no scheme gets
# automatically re-scored. GEMINI_API_KEY is preferred when both are set (free
# tier at aistudio.google.com; ANTHROPIC_API_KEY is billed per-use at console.anthropic.com).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
